# Copy to .env and fill in. Never commit the real file.
SENTRY_AUTH_TOKENS_0_TOKEN=change-me
SENTRY_AUTH_TOKENS_0_PROJECTS_0=*
SENTRY_ALLOWED_ROOTS_0=/data/projects
SENTRY_RISK_ENABLED=false
SENTRY_RISK_BASE_URL=http://breakcast:8090
SENTRY_EXPLANATION_PROVIDER=DISABLED
SENTRY_EXPLANATION_API_KEY_ENVIRONMENT_VARIABLE=EXPLANATION_API_KEY
EXPLANATION_API_KEY=
SENTRY_AZURE_ENABLED=false
SENTRY_AZURE_HOST=
SENTRY_AZURE_USER=
SENTRY_AZURE_IDENTITY_FILE=
SENTRY_AZURE_KNOWN_HOSTS_FILE=
